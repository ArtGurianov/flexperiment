FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json pnpm-lock.yaml ./
COPY commerce ./commerce
# Node's bundled trust store does not include every Russian trusted root used
# by the production acquiring provider. Keep this root certificate immutable
# with the runtime source; never disable TLS verification.
ENV NODE_EXTRA_CA_CERTS=/app/commerce/certs/russian-trusted-root-ca.pem
# Commerce runtime imports the canonical city catalogue from the shared root
# module. Keep shared runtime dependencies explicit in the production image.
COPY lib ./lib
COPY public/legal ./public/legal
# The runtime stage is a fresh Node image: activate the package manager used
# by CMD here rather than relying on the dependencies stage's Corepack shim.
RUN corepack enable \
  && pnpm --version \
  && mkdir -p /var/lib/flexperiment \
  && chown -R node:node /var/lib/flexperiment
USER node
EXPOSE 3001
CMD ["pnpm", "commerce:start"]
