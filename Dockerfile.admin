FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
ARG SOURCE_COMMIT
ENV SOURCE_COMMIT=${SOURCE_COMMIT}
COPY apps/admin ./apps/admin
# Admin shares the canonical city catalogue with Commerce at the repository
# root; include it before resolving the static export's imports.
COPY lib ./lib
COPY release-surface-contract.json ./
RUN pnpm --filter @flexperiment/admin build

FROM nginx:1.29-alpine
COPY deploy/admin.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/admin/out /usr/share/nginx/html
EXPOSE 80
