+      this.db.prepare("UPDATE cities SET slug = ?, title = ? WHERE id = ?").run(canonicalCity.slug, canonicalCity.title, cityId);
+      const city = one(this.db, "SELECT * FROM cities WHERE id = ?", cityId)!;
