{
  "schema": "flexperiment.my-identity.route-audience/1",
  "mode": "on",
  "refusal": { "status": 403, "code": "SESSION_AUDIENCE_FORBIDDEN", "headers": { "Cache-Control": "no-store" } },
  "routes": [
    { "method": "POST", "path": "/v1/my/otp/send", "surface": "MY", "session": "none", "origin": "MY" },
    { "method": "POST", "path": "/v1/my/otp/verify", "surface": "MY", "session": "none", "origin": "MY" },
    { "method": "GET", "path": "/v1/my/session", "surface": "MY", "session": "optional" },
    { "method": "POST", "path": "/v1/my/sign-out", "surface": "MY", "session": "MY", "origin": "MY" },
    { "method": "GET", "path": "/v1/my/profile", "surface": "MY", "session": "MY" },
    { "method": "GET", "path": "/v1/my/exchange/:tx", "surface": "MY", "session": "optional" },
    { "method": "POST", "path": "/v1/my/exchange/:tx/issue", "surface": "MY", "session": "MY", "origin": "MY" },
    { "method": "POST", "path": "/v1/my/exchange/:tx/cancel", "surface": "MY", "session": "optional", "origin": "MY" },
    { "method": "POST", "path": "/v1/checkout/preview", "surface": "MY", "session": "MY", "note": "C owns semantics; B owns the audience guard" },
    { "method": "POST", "path": "/v1/checkout", "surface": "MY", "session": "MY" },
    { "method": "POST", "path": "/v1/checkout/handoff", "surface": "MY", "session": "MY" },
    { "method": "GET", "path": "/v1/checkout/:orderPublicId", "surface": "MY", "session": "MY" },
    { "method": "GET", "path": "/v1/refunds", "surface": "MY", "session": "MY" },
    { "method": "POST", "path": "/v1/refunds", "surface": "MY", "session": "MY" },
    { "method": "GET", "path": "/v1/me/orders", "surface": "MY", "session": "MY" },
    { "method": "GET", "path": "/v1/me/consents", "surface": ["MY", "LMS"], "session": "surface kind" },
    { "method": "POST", "path": "/v1/me/consents", "surface": "MY", "session": "MY", "origin": "MY" },
    { "method": "GET", "path": "/v1/me", "surface": ["LMS", "LAB"], "session": "surface kind", "view": "limited (profile.json)" },
    { "method": "GET", "path": "/v1/me/course-library", "surface": "LMS", "session": "LMS" },
    { "method": "GET", "path": "/v1/me/courses/:slug", "surface": "LMS", "session": "LMS" },
    { "method": "GET", "path": "/v1/me/courses/:slug/lessons/:lessonSlug", "surface": "LMS", "session": "LMS" },
    { "method": "GET", "path": "/v1/library", "surface": "LMS", "session": "LMS" },
    { "method": "PUT", "path": "/v1/lessons/:lessonRef/resume", "surface": "LMS", "session": "LMS" },
    { "method": "POST", "path": "/v1/lessons/:lessonRef/playback", "surface": "LMS", "session": "LMS" },
    { "method": "POST", "path": "/v1/lms/exchange/start", "surface": "LMS", "session": "none", "origin": "none (server-to-server from /auth/lms/start)" },
    { "method": "POST", "path": "/v1/lms/exchange/redeem", "surface": "LMS", "session": "none", "origin": "MY" },
    { "method": "GET", "path": "/v1/lms/session", "surface": "LMS", "session": "LMS", "view": "masked Navbar" },
    { "method": "POST", "path": "/v1/lms/sign-out", "surface": "LMS", "session": "LMS", "origin": "LMS" },
    { "method": "POST", "path": "/v1/auth/sign-in/magic-link", "surface": "LMS", "session": "none", "modeOn": { "status": 410, "code": "MAGIC_LINK_RETIRED" } }
  ],
  "isolationCases": [
    { "credential": "MY", "surface": "LMS", "route": "POST /v1/lessons/:lessonRef/playback", "expect": { "status": 401, "decision": "SIGN_IN_REQUIRED" } },
    { "credential": "LMS", "surface": "MY", "route": "POST /v1/checkout", "expect": { "status": 401 } },
    { "credential": "LMS", "surface": "LMS", "route": "POST /v1/checkout", "expect": { "status": 403, "code": "SESSION_AUDIENCE_FORBIDDEN" } },
    { "credential": "MY", "surface": "MY", "route": "POST /v1/lessons/:lessonRef/playback", "expect": { "status": 403, "code": "SESSION_AUDIENCE_FORBIDDEN" } },
    { "credential": "LEGACY", "surface": "LMS", "route": "GET /v1/me/course-library", "expect": { "status": 401, "code": "SIGN_IN_REQUIRED" } },
    { "credential": "LEGACY", "surface": "MY", "route": "GET /v1/my/profile", "expect": { "status": 401, "code": "SIGN_IN_REQUIRED" } },
    { "credential": "LMS (parent revoked)", "surface": "LMS", "route": "GET /v1/me/course-library", "expect": { "status": 401, "code": "SIGN_IN_REQUIRED" } }
  ]
}
