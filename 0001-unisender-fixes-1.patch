+  private unknownEmailRetryAt(attempts: number) {
+    const exponent = Math.max(0, Math.min(attempts - 1, 16));
+    const delay = Math.min(EMAIL_SEND_UNKNOWN_INITIAL_BACKOFF_MS * (2 ** exponent), EMAIL_SEND_UNKNOWN_MAX_BACKOFF_MS);
