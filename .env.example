# Public commerce origin and durable SQLite location
COMMERCE_DATABASE_PATH=/var/lib/flexperiment/commerce.sqlite
COMMERCE_PUBLIC_ORIGIN=https://flexperiment.ru
COMMERCE_ADMIN_ORIGIN=https://admin.flexperiment.ru
# Immutable deployment revision, injected by CI/Coolify. It is public build
# metadata used only by the authenticated certification evidence endpoint.
SOURCE_COMMIT=CHANGE_ME_GIT_COMMIT

# Public at build time only: client-side Commerce calls use this cross-origin API.
# Set this in the static frontend build environment, not only at runtime.
NEXT_PUBLIC_COMMERCE_API_URL=https://api.flexperiment.ru
# Public build-time SmartCaptcha key; this is intentionally not a secret.
NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_SITE_KEY=ysc1_CHANGE_ME

# Generate unique 32-byte values before any real deployment. Never commit real values.
COMMERCE_EMAIL_HMAC_KEY=CHANGE_ME
COMMERCE_TICKET_KEY_BASE64=CHANGE_ME_32_BYTE_BASE64
COMMERCE_SESSION_SECRET=CHANGE_ME
# Dedicated CI-only bearer credential for /v1/internal/release-control/*.
# It is not an Admin password and must exist only in the deployment secret store.
COMMERCE_RELEASE_CONTROL_TOKEN=CHANGE_ME

# `scrypt:v1:16384:8:1:base64url-salt:base64url-scrypt-hash` from
# `node generate-admin-password.mjs`; no development fallback is available.
COMMERCE_ADMIN_PASSWORD_SCRYPT=CHANGE_ME

# Private Commerce runtime key used only to verify one-time SmartCaptcha tokens.
YANDEX_SMARTCAPTCHA_SERVER_KEY=ysc2_CHANGE_ME

# Mock is for disposable local development only. Leave it unset in production.
COMMERCE_PROVIDER=mock

# Runtime-only provider configuration. Never paste real values into this file.
TOCHKA_API_BASE_URL=https://enter.tochka.com/uapi
TOCHKA_JWT=CHANGE_ME
# Required for production JWT/webhook configuration; omit in the Tochka sandbox.
TOCHKA_CLIENT_ID=CHANGE_ME
TOCHKA_CUSTOMER_CODE=CHANGE_ME
TOCHKA_MERCHANT_ID=CHANGE_ME
TOCHKA_TAX_SYSTEM_CODE=usn_income
TOCHKA_VAT_TYPE=none

UNISENDER_GO_API_KEY=CHANGE_ME
UNISENDER_GO_FROM_EMAIL=CHANGE_ME
UNISENDER_GO_FROM_NAME=CHANGE_ME
UNISENDER_GO_REPLY_TO_EMAIL=CHANGE_ME

# Flexperiment v2 is an independent lineage and independent pair of apps.
# These values do not replace or reuse the v1 database or provider secrets.
COMMERCE_V2_DATABASE_PATH=/var/lib/flexperiment-v2/commerce.sqlite
PAYLOAD_DATABASE_URL=file:/var/lib/flexperiment-v2/platform.sqlite
PAYMENT_MODE=disabled
MERCHANT_PROMOTION_PREFIX=FX-
REFREF_API_BASE_URL=
REFREF_CHECKOUT_ORIGIN=https://checkout.refref.ru
REFREF_API_KEY=
REFREF_MERCHANT_SLUG=
REFREF_MERCHANT_ID=
REFREF_RETURN_URL=
REFREF_HANDOFF_STATE_SECRET=
# Must be the accountant-approved Refref fiscal enum before Stage B.
REFREF_RECEIPT_PAYMENT_METHOD=
KINESCOPE_DELIVERY_MODE=open
PUBLIC_COMMERCE_ORIGIN=https://flexperiment.ru
# Public and non-secret, but also a platform image build input: metadata and
# structured data in the static shell must never retain the CI placeholder.
COMMERCE_INTERNAL_ORIGIN=http://commerce-v2:3002
COMMERCE_ADMIN_ORIGIN=https://admin.flexperiment.ru
NEXT_PUBLIC_SERVER_URL=https://flexperiment.ru
PLATFORM_SERVICE_TOKEN=CHANGE_ME
PLATFORM_COMMERCE_SERVICE_TOKEN=CHANGE_ME_SAME_VALUE
PLATFORM_REVALIDATE_TOKEN=CHANGE_ME
PAYLOAD_SECRET=CHANGE_ME_32_BYTES_OR_LONGER
# Public CMS images. S3_PUBLIC_URL is non-secret and must also be present in
# the platform image build so Next.js can bake the exact image host into CSP
# and the image optimizer allowlist.
S3_BUCKET=CHANGE_ME
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_URL=https://flexperiment.s3.cloud.ru
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTES_OR_LONGER
AUTH_EMAIL_OUTBOX_KEY=CHANGE_ME_32_BYTE_BASE64
AUTH_EMAIL_DELIVERY_ENDPOINT=https://email-gateway.example/magic-link
AUTH_EMAIL_DELIVERY_TOKEN=CHANGE_ME
CAMPAIGN_UNSUBSCRIBE_SECRET=CHANGE_ME_32_BYTES_OR_LONGER
AUTH_TRUSTED_ORIGINS=https://flexperiment.ru
SMARTCAPTCHA_SERVER_KEY=ysc2_CHANGE_ME
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=ysc1_CHANGE_ME
NEXT_PUBLIC_YANDEX_METRIKA_ID=
YANDEX_WEBMASTER_VERIFICATION=
KINESCOPE_API_TOKEN=CHANGE_ME
KINESCOPE_LESSONS_FOLDER_ID=CHANGE_ME
KINESCOPE_WEBHOOK_USERNAME=CHANGE_ME
KINESCOPE_WEBHOOK_PASSWORD=CHANGE_ME
KINESCOPE_DRM_TOKEN_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
KINESCOPE_DRM_USERNAME=CHANGE_ME
KINESCOPE_DRM_PASSWORD=CHANGE_ME
INDEXNOW_KEY=CHANGE_ME
CHECKOUT_POLL_INTERVAL_MS=30000

# Coolify, which owns the deployment of all four surfaces. The cutover pins an
# exact commit per application rather than trusting a branch to point where it
# did a moment ago, so the token needs application read/update and deploy.
COOLIFY_API_URL=https://coolify.example/api/v1
COOLIFY_TOKEN=CHANGE_ME
COOLIFY_FRONTEND_APP_UUID=CHANGE_ME
COOLIFY_ADMIN_APP_UUID=CHANGE_ME
COOLIFY_COMMERCE_APP_UUID=CHANGE_ME
# A DISPOSABLE application the capability probe may deploy and roll back, and
# the commit it may deploy there. Never one of the three above.
COOLIFY_PROBE_APP_UUID=CHANGE_ME
COOLIFY_PROBE_COMMIT=CHANGE_ME_GIT_COMMIT
