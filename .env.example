# Public commerce origin and durable SQLite location
COMMERCE_DATABASE_PATH=/var/lib/flexperiment/commerce.sqlite
COMMERCE_PUBLIC_ORIGIN=https://flexperiment.ru
COMMERCE_ADMIN_ORIGIN=https://admin.flexperiment.ru

# Public at build time only: client-side Commerce calls use this cross-origin API.
# Set this in the static frontend build environment, not only at runtime.
NEXT_PUBLIC_COMMERCE_API_URL=https://api.flexperiment.ru

# Generate unique 32-byte values before any real deployment. Never commit real values.
COMMERCE_EMAIL_HMAC_KEY=CHANGE_ME
COMMERCE_TICKET_KEY_BASE64=CHANGE_ME_32_BYTE_BASE64
COMMERCE_SESSION_SECRET=CHANGE_ME

# `salt:base64url-scrypt-hash`; no development fallback is available for Admin.
COMMERCE_ADMIN_PASSWORD_SCRYPT=CHANGE_ME

# Mock is for disposable local development only. Leave it unset in production.
COMMERCE_PROVIDER=mock

# Runtime-only provider configuration. Never paste real values into this file.
TOCHKA_API_BASE_URL=https://enter.tochka.com/uapi
TOCHKA_JWT=CHANGE_ME
TOCHKA_CLIENT_ID=CHANGE_ME
TOCHKA_CUSTOMER_CODE=CHANGE_ME
TOCHKA_MERCHANT_ID=CHANGE_ME
TOCHKA_TAX_SYSTEM_CODE=usn_income
TOCHKA_VAT_TYPE=none

UNISENDER_GO_API_KEY=CHANGE_ME
UNISENDER_GO_FROM_EMAIL=CHANGE_ME
UNISENDER_GO_FROM_NAME=CHANGE_ME
UNISENDER_GO_REPLY_TO_EMAIL=CHANGE_ME
