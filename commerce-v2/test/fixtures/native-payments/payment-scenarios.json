{
  "schema": "flexperiment.native-payment-fixtures/1",
  "contract": "flexperiment.native-payment-contract/1",
  "bindings": {
    "course": {
      "merchantOrderRef": "ord-course-0001",
      "amountKopecks": 490000,
      "currency": "RUB",
      "snapshotHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "lab": {
      "merchantOrderRef": "ord-lab-0001",
      "amountKopecks": 350000,
      "currency": "RUB",
      "snapshotHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  },
  "begin": [
    {
      "mayInitiate": true,
      "expect": {
        "state": "CREATING",
        "effects": [
          "PROVIDER_CREATE"
        ]
      }
    },
    {
      "mayInitiate": false,
      "expect": {
        "state": "CREATING",
        "effects": [],
        "reason": "PAYMENT_INITIATION_STOPPED"
      }
    }
  ],
  "scenarios": [
    {
      "id": "P01",
      "title": "Happy course payment; repeated read-back is idempotent",
      "binding": "course",
      "kind": "ONLINE_COURSE",
      "fiscalizationMode": "MERCHANT",
      "steps": [
        {
          "observe": {
            "source": "CREATE_RESPONSE",
            "outcome": "ACCEPTED",
            "providerPaymentId": "fake-pay-1"
          },
          "expect": {
            "state": "PENDING",
            "effects": [
              "READ_BACK"
            ]
          }
        },
        {
          "observe": {
            "source": "READ_BACK",
            "outcome": "FOUND",
            "providerPaymentId": "fake-pay-1",
            "status": "PENDING",
            "merchantOrderRef": "ord-course-0001",
            "amountKopecks": 490000,
            "currency": "RUB",
            "snapshotHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "expect": {
            "state": "PENDING",
            "effects": []
          }
        },
        {
          "observe": {
            "source": "READ_BACK",
            "outcome": "FOUND",
            "providerPaymentId": "fake-pay-1",
            "status": "PAID",
            "merchantOrderRef": "ord-course-0001",
            "amountKopecks": 490000,
            "currency": "RUB",
            "snapshotHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "expect": {
            "state": "PAID",
            "effects": [
              "GRANT",
              "ISSUE_PAYMENT_RECEIPT"
            ]
          }
        },
        {
          "observe": {
            "source": "READ_BACK",
            "outcome": "FOUND",
            "providerPaymentId": "fake-pay-1",
            "status": "PAID",
            "merchantOrderRef": "ord-course-0001",
            "amountKopecks": 490000,
            "currency": "RUB",
            "snapshotHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "expect": {
            "state": "PAID",
            "effects": []
          }
        }
      ],
      "totals": {
        "GRANT": 1
      }
    },
