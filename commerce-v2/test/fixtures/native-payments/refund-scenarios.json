        "alreadyRefundedKopecks": 0,
        "finalSettlementState": null
      },
      "expect": {
        "admitted": false,
        "code": "REFUND_FULL_ONLY"
      }
    },
    {
      "id": "A05",
      "input": {
        "contour": "NATIVE",
        "paymentState": "PAID",
        "lineAmountKopecks": 490000,
        "approvedAmountKopecks": 490000,
        "alreadyRefundedKopecks": 490000,
        "finalSettlementState": null
      },
      "expect": {
        "admitted": false,
        "code": "REFUND_FULL_ONLY"
