{
  "schema": "flexperiment.native-refund-fixtures/1",
  "contract": "flexperiment.native-payment-contract/1",
  "binding": {
    "providerPaymentId": "fake-pay-1",
    "amountKopecks": 490000,
    "currency": "RUB",
    "refundRef": "refund:rr-0001"
  },
  "begin": {
    "expect": {
      "state": "SUBMITTING",
      "effects": [
        "PROVIDER_REFUND_SUBMIT"
      ]
    }
  },
  "admission": [
    {
      "id": "A01",
      "input": {
        "contour": "NATIVE",
        "paymentState": "PAID",
        "lineAmountKopecks": 490000,
        "approvedAmountKopecks": 490000,
        "alreadyRefundedKopecks": 0,
        "finalSettlementState": null
      },
      "expect": {
        "admitted": true
      }
    },
    {
      "id": "A02",
      "input": {
        "contour": "REFREF_RC2",
        "paymentState": "PAID",
        "lineAmountKopecks": 490000,
        "approvedAmountKopecks": 490000,
        "alreadyRefundedKopecks": 0,
        "finalSettlementState": null
      },
      "expect": {
        "admitted": false,
        "code": "REFUND_ROUTED_TO_ORIGINAL_CONTOUR"
      }
    },
    {
      "id": "A03",
      "input": {
        "contour": "NATIVE",
        "paymentState": "CREATE_UNKNOWN",
