              "ALERT"
            ],
            "reason": "REFUND_BINDING_MISMATCH"
          }
        }
      ],
      "totals": {
        "REVOKE_ACCESS": 0
      }
    },
    {
      "id": "R08",
      "title": "Forged callback ignored; valid callback only schedules a read-back",
      "fiscalizationMode": "MERCHANT",
      "steps": [
        {
          "observe": {
            "source": "SUBMIT_RESPONSE",
            "outcome": "ACCEPTED",
