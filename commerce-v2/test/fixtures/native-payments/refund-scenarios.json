      "steps": [
        {
          "observe": {
            "source": "SUBMIT_RESPONSE",
            "outcome": "REFUSED",
            "code": "HTTP_409",
            "proven": false
          },
          "expect": {
            "state": "REVIEW_REQUIRED",
            "effects": [
              "ALERT"
            ],
            "reason": "HTTP_409"
          }
        }
      ],
      "totals": {
        "REVOKE_ACCESS": 0,
        "PURGE_ENVELOPE": 0
      }
    },
