  "scenarios": [
    {
      "id": "R01",
      "title": "Happy full refund; repeated read-back is idempotent",
      "fiscalizationMode": "MERCHANT",
      "steps": [
        {
          "observe": {
            "source": "SUBMIT_RESPONSE",
            "outcome": "ACCEPTED",
            "providerRefundId": "fake-refund-1"
          },
          "expect": {
            "state": "PROCESSING",
            "effects": [
              "READ_BACK"
            ]
          }
        },
        {
          "observe": {
            "source": "READ_BACK",
            "outcome": "FOUND",
            "providerRefundId": "fake-refund-1",
            "status": "PROCESSING",
            "providerPaymentId": "fake-pay-1",
            "amountKopecks": 490000,
            "currency": "RUB",
            "refundRef": "refund:rr-0001"
          },
          "expect": {
            "state": "PROCESSING",
            "effects": []
          }
        },
        {
          "observe": {
            "source": "READ_BACK",
            "outcome": "FOUND",
            "providerRefundId": "fake-refund-1",
            "status": "SUCCEEDED",
            "providerPaymentId": "fake-pay-1",
            "amountKopecks": 490000,
            "currency": "RUB",
            "refundRef": "refund:rr-0001"
          },
          "expect": {
            "state": "SUCCEEDED",
            "effects": [
              "REVOKE_ACCESS",
              "ISSUE_REFUND_RECEIPT",
              "PURGE_ENVELOPE"
            ]
          }
        },
        {
          "observe": {
            "source": "READ_BACK",
            "outcome": "FOUND",
            "providerRefundId": "fake-refund-1",
            "status": "SUCCEEDED",
            "providerPaymentId": "fake-pay-1",
            "amountKopecks": 490000,
            "currency": "RUB",
            "refundRef": "refund:rr-0001"
          },
          "expect": {
            "state": "SUCCEEDED",
            "effects": []
          }
        }
      ],
      "totals": {
        "REVOKE_ACCESS": 1
      }
    },
    {
      "id": "R02",
      "title": "Submit answer lost, provider had accepted",
      "fiscalizationMode": "MERCHANT",
      "steps": [
        {
          "observe": {
            "source": "SUBMIT_RESPONSE",
            "outcome": "LOST"
          },
          "expect": {
            "state": "SUBMIT_UNKNOWN",
            "effects": [
              "READ_BACK"
            ]
          }
        },
        {
          "observe": {
            "source": "READ_BACK",
            "outcome": "FOUND",
            "providerRefundId": "fake-refund-1",
            "status": "SUCCEEDED",
            "providerPaymentId": "fake-pay-1",
            "amountKopecks": 490000,
            "currency": "RUB",
            "refundRef": "refund:rr-0001"
          },
          "expect": {
            "state": "SUCCEEDED",
            "effects": [
              "REVOKE_ACCESS",
              "ISSUE_REFUND_RECEIPT",
              "PURGE_ENVELOPE"
            ]
          }
        }
      ],
      "totals": {
        "REVOKE_ACCESS": 1
      }
    },
    {
      "id": "R03",
      "title": "Submit answer lost, nothing at provider: replay same sealed envelope and key",
      "fiscalizationMode": "MERCHANT",
      "steps": [
        {
          "observe": {
            "source": "SUBMIT_RESPONSE",
            "outcome": "LOST"
          },
          "expect": {
            "state": "SUBMIT_UNKNOWN",
            "effects": [
              "READ_BACK"
            ]
          }
        },
        {
          "observe": {
            "source": "READ_BACK",
            "outcome": "NOT_FOUND"
          },
          "expect": {
            "state": "SUBMIT_UNKNOWN",
            "effects": [
              "REPLAY_REFUND_SAME_KEY"
            ]
          }
        },
        {
          "observe": {
            "source": "SUBMIT_RESPONSE",
            "outcome": "ACCEPTED",
            "providerRefundId": "fake-refund-1"
          },
          "expect": {
            "state": "PROCESSING",
            "effects": [
              "READ_BACK"
            ]
          }
        },
        {
          "observe": {
            "source": "READ_BACK",
            "outcome": "FOUND",
            "providerRefundId": "fake-refund-1",
            "status": "SUCCEEDED",
            "providerPaymentId": "fake-pay-1",
            "amountKopecks": 490000,
            "currency": "RUB",
            "refundRef": "refund:rr-0001"
          },
          "expect": {
            "state": "SUCCEEDED",
            "effects": [
              "REVOKE_ACCESS",
              "ISSUE_REFUND_RECEIPT",
              "PURGE_ENVELOPE"
            ]
          }
        }
      ],
      "totals": {
        "REVOKE_ACCESS": 1,
        "REPLAY_REFUND_SAME_KEY": 1
      }
    },
    {
      "id": "R04",
      "title": "Proven terminal refusal: envelope purged, access stays",
      "fiscalizationMode": "MERCHANT",
      "steps": [
        {
          "observe": {
            "source": "SUBMIT_RESPONSE",
            "outcome": "REFUSED",
            "code": "REFUND_DECLINED",
            "proven": true
          },
          "expect": {
            "state": "FAILED",
            "effects": [
              "PURGE_ENVELOPE",
              "ALERT"
            ],
            "reason": "REFUND_DECLINED"
          }
        }
      ],
      "totals": {
        "REVOKE_ACCESS": 0
      }
    },
    {
      "id": "R05",
