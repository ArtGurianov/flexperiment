      },
      "expect": {
        "admitted": false,
        "code": "REFUND_AFTER_FINAL_SETTLEMENT_NOT_SUPPORTED"
      }
    },
    {
      "id": "A08",
      "input": {
        "contour": "NATIVE",
        "paymentState": "PAID",
