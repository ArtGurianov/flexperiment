FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/platform/package.json ./apps/platform/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
ARG SOURCE_COMMIT
ARG PLATFORM_ORIGIN=https://flexperiment.ru
ARG S3_PUBLIC_URL=https://flexperiment.s3.cloud.ru
ARG YANDEX_WEBMASTER_VERIFICATION
ENV SOURCE_COMMIT=${SOURCE_COMMIT} \
    PLATFORM_ORIGIN=${PLATFORM_ORIGIN} \
    S3_PUBLIC_URL=${S3_PUBLIC_URL} \
    YANDEX_WEBMASTER_VERIFICATION=${YANDEX_WEBMASTER_VERIFICATION} \
    DEPLOY_ENV=staging
COPY . .
RUN pnpm platform:build

FROM node:22-bookworm-slim AS identity
WORKDIR /identity
ARG SOURCE_COMMIT
COPY scripts/write-build-identity.mjs /tmp/write-build-identity.mjs
RUN SOURCE_COMMIT=${SOURCE_COMMIT} node /tmp/write-build-identity.mjs /identity/identity.json platform

FROM node:22-bookworm-slim
WORKDIR /app
ARG SOURCE_COMMIT
ARG PLATFORM_ORIGIN=https://flexperiment.ru
ARG S3_PUBLIC_URL=https://flexperiment.s3.cloud.ru
ARG YANDEX_WEBMASTER_VERIFICATION
ENV NODE_ENV=production \
    COREPACK_HOME=/opt/corepack \
    COREPACK_ENABLE_NETWORK=0 \
    HOSTNAME=0.0.0.0 \
    PORT=3001 \
    SOURCE_COMMIT=${SOURCE_COMMIT} \
    PLATFORM_ORIGIN=${PLATFORM_ORIGIN} \
    S3_PUBLIC_URL=${S3_PUBLIC_URL} \
    YANDEX_WEBMASTER_VERIFICATION=${YANDEX_WEBMASTER_VERIFICATION} \
    BUILD_IDENTITY_FILE=/app/.identity/identity.json
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/apps/platform/node_modules ./apps/platform/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --from=build /app/apps/platform ./apps/platform
COPY --from=identity --chmod=0444 /identity/identity.json /app/.identity/identity.json
RUN corepack enable \
  && COREPACK_ENABLE_NETWORK=1 corepack install \
  && chmod -R a+rX /opt/corepack \
  && chown -R node:node /app \
  && chmod 0555 /app/.identity \
  && chmod 0444 /app/.identity/identity.json
USER node
EXPOSE 3001
CMD ["sh", "-c", "umask 077 && pnpm --filter @flexperiment/platform start"]
