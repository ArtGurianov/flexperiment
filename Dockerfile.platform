FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/platform/package.json ./apps/platform/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
ARG SOURCE_COMMIT
ARG PLATFORM_ORIGIN=https://flexperiment.ru
ARG S3_PUBLIC_URL=https://flexperiment.s3.cloud.ru
ARG YANDEX_WEBMASTER_VERIFICATION
ENV SOURCE_COMMIT=${SOURCE_COMMIT} \
    PAYLOAD_SECRET=build-only-not-a-runtime-secret \
    PAYLOAD_DATABASE_URL=file:/tmp/platform-build.sqlite \
    PLATFORM_ORIGIN=${PLATFORM_ORIGIN} \
    S3_PUBLIC_URL=${S3_PUBLIC_URL} \
    YANDEX_WEBMASTER_VERIFICATION=${YANDEX_WEBMASTER_VERIFICATION} \
    DEPLOY_ENV=staging \
    PAYLOAD_JOBS_ENABLED=false
COPY . .
RUN pnpm platform:build

FROM node:22-bookworm-slim AS identity
WORKDIR /identity
ARG SOURCE_COMMIT
COPY scripts/write-build-identity.mjs /tmp/write-build-identity.mjs
RUN SOURCE_COMMIT=${SOURCE_COMMIT} node /tmp/write-build-identity.mjs /identity/identity.json platform

FROM node:22-bookworm-slim
WORKDIR /app
ARG SOURCE_COMMIT
ARG PLATFORM_ORIGIN=https://flexperiment.ru
ARG S3_PUBLIC_URL=https://flexperiment.s3.cloud.ru
ARG YANDEX_WEBMASTER_VERIFICATION
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3001 \
    SOURCE_COMMIT=${SOURCE_COMMIT} \
    PLATFORM_ORIGIN=${PLATFORM_ORIGIN} \
    S3_PUBLIC_URL=${S3_PUBLIC_URL} \
    YANDEX_WEBMASTER_VERIFICATION=${YANDEX_WEBMASTER_VERIFICATION} \
    BUILD_IDENTITY_FILE=/app/.identity/identity.json \
    PAYLOAD_DATABASE_URL=file:/var/lib/flexperiment-v2/platform.sqlite
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/apps/platform/node_modules ./apps/platform/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --from=build /app/apps/platform ./apps/platform
# Payload loads its config directly for owner migrations before starting Next. Its shared pure
# validator is not in the Next bundle at that boundary; ship the exact commerce source as well.
COPY --from=build /app/commerce-v2/src/payment-purpose.ts ./commerce-v2/src/payment-purpose.ts
COPY --from=identity --chmod=0444 /identity/identity.json /app/.identity/identity.json
RUN corepack enable \
  && mkdir -p /var/lib/flexperiment-v2 \
  && chown -R node:node /var/lib/flexperiment-v2 /app \
  && chmod 0555 /app/.identity \
  && chmod 0444 /app/.identity/identity.json
USER node
EXPOSE 3001
CMD ["sh", "-c", "pnpm --filter @flexperiment/platform migrate && pnpm --filter @flexperiment/platform start"]
