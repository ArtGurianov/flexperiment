# Stand-only consumer image. Includes synthetic fixture setup, never a release image.
FROM node:22-bookworm-slim
WORKDIR /app
ENV CI=true
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
ARG SOURCE_COMMIT
RUN printf '%s' "$SOURCE_COMMIT" | grep -Eqx '[0-9a-f]{40}'
LABEL refref.qualification-only="true"
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT}
ENV NODE_ENV=test
USER node
CMD ["node","--import","tsx","commerce-v2/test/fixtures/v9-http-contour.ts"]
