# Reference reverse-proxy topology. Translate this routing verbatim to the
# target Coolify/Traefik configuration; it intentionally emits no CORS headers.
flexperiment.ru {
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }
  @commerce path /v1/* /healthz /readyz
  reverse_proxy @commerce commerce:3001
  root * /srv/flexperiment/out
  file_server
}

admin.flexperiment.ru {
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }
  reverse_proxy commerce:3001
}

# Phase 9: partner.flexperiment.ru is served by the SAME frontend
# container as admin.flexperiment.ru (deploy/admin.nginx.conf's own
# server_name blocks are the actual host-based routing boundary between
# the two realms - see that file's header) - never a separate deployable
# app/container. Mirrors the admin block above exactly; a future change to
# how this reference topology reaches the frontend container must update
# both blocks together.
partner.flexperiment.ru {
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }
  reverse_proxy commerce:3001
}
