# Reference reverse-proxy topology. Translate this routing verbatim to the
# target Coolify/Traefik configuration; it intentionally emits no CORS headers.
flexperiment.ru {
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }
  @commerce path /v1/* /healthz /readyz
  reverse_proxy @commerce commerce:3001
  root * /srv/flexperiment/out
  file_server
}

admin.flexperiment.ru {
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }
  reverse_proxy commerce:3001
}
