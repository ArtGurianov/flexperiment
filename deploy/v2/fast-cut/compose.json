{
  "name": "flexperiment-fast-cut-canary",
  "services": {
    "commerce": {
      "image": "ghcr.io/artgurianov/flexperiment-commerce-v2@sha256:ae982e7629f93db45ebc79b9ef623756f13da85fb7b2a5a91d7e47a926754c92",
      "container_name": "flexperiment-fast-cut-canary-commerce",
      "restart": "unless-stopped",
      "read_only": true,
      "labels": {
        "com.flexperiment.scope": "canary-fast-cut",
        "com.flexperiment.source": "08523bdf38eeddf5e745ce04d05e1f980a7ced93"
      },
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": {
        "canary": {
          "aliases": [
            "xzuy7pk5y6ywjr9kh6nsk5ap"
          ]
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=64m"
      ],
      "init": true,
      "env_file": [
        {
          "path": "/etc/flexperiment-fast-cut-canary/commerce.env",
          "format": "raw"
        }
      ],
      "volumes": [
        "commerce-data:/var/lib/flexperiment-v2",
        "commerce-backups:/var/lib/flexperiment-v2-backups",
        {
          "type": "bind",
          "source": "/var/lib/flexperiment-erasure-canary/installation",
          "target": "/etc/flexperiment-erasure",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/var/lib/flexperiment-erasure-canary/runtime-keys",
          "target": "/etc/flexperiment-erasure-keys",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/var/lib/flexperiment-erasure-canary/runtime-read",
          "target": "/etc/flexperiment-erasure-read",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/var/lib/flexperiment-erasure-canary/mirror",
          "target": "/etc/flexperiment-erasure-mirror",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/var/lib/flexperiment-erasure-canary/fence",
          "target": "/var/lib/flexperiment-erasure-canary/fence",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "--max-time",
          "10",
          "http://127.0.0.1:3002/readyz"
        ],
        "interval": "15s",
        "timeout": "12s",
        "retries": 6,
        "start_period": "20s"
      }
    },
    "platform": {
      "image": "ghcr.io/artgurianov/flexperiment-platform-v2@sha256:8414358ba700c48e18891346e62e6cd9ea7658fb669114860c356ead1a4a6e46",
      "container_name": "flexperiment-fast-cut-canary-platform",
      "restart": "unless-stopped",
      "read_only": true,
      "labels": {
        "com.flexperiment.scope": "canary-fast-cut",
        "com.flexperiment.source": "08523bdf38eeddf5e745ce04d05e1f980a7ced93"
      },
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": [
        "canary"
      ],
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=64m"
      ],
      "init": true,
      "env_file": [
        {
          "path": "/etc/flexperiment-fast-cut-canary/platform.env",
          "format": "raw"
        }
      ],
      "depends_on": {
        "commerce": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3001/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 6,
        "start_period": "30s"
      }
    },
    "admin": {
      "image": "ghcr.io/artgurianov/flexperiment-admin-v2@sha256:85eadc71e50fdab0bc4d154a242a46188bd85bbe7f0edfed516f8863eb14dc77",
      "container_name": "flexperiment-fast-cut-canary-admin",
      "restart": "unless-stopped",
      "read_only": true,
      "labels": {
        "com.flexperiment.scope": "canary-fast-cut",
        "com.flexperiment.source": "08523bdf38eeddf5e745ce04d05e1f980a7ced93"
      },
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": [
        "canary"
      ],
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=64m",
        "/var/cache/nginx:rw,nosuid,nodev,noexec,size=32m",
        "/var/run:rw,nosuid,nodev,noexec,size=4m"
      ],
      "cap_add": [
        "CHOWN",
        "SETUID",
        "SETGID",
        "NET_BIND_SERVICE"
      ],
      "depends_on": {
        "commerce": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        {
          "type": "bind",
          "source": "./admin.conf",
          "target": "/etc/nginx/conf.d/default.conf",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "../frontends",
          "target": "/etc/nginx/v2",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./admin-common.conf",
          "target": "/etc/nginx/fast-cut/admin-common.conf",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "-O",
          "/dev/null",
          "http://127.0.0.1/readyz"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 6
      }
    }
  },
  "networks": {
    "canary": {
      "name": "flexperiment-fast-cut-canary"
    }
  },
  "volumes": {
    "commerce-data": {
      "external": true,
      "name": "xzuy7pk5y6ywjr9kh6nsk5ap-xzuy7pk5y6ywjr9kh6nsk5ap-commerce-v2-data"
    },
    "commerce-backups": {
      "external": true,
      "name": "xzuy7pk5y6ywjr9kh6nsk5ap-xzuy7pk5y6ywjr9kh6nsk5ap-commerce-v2-backups"
    }
  }
}
