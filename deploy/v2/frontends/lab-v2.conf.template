server {
    listen 80 default_server;
    server_name _;
    access_log off;
    error_log /dev/null crit;
    server_tokens off;
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $commerce_upstream ${V2_COMMERCE_UPSTREAM};
    location = /healthz { return 200 'frontend alive'; }
    # Coolify probes the private container without a public Host header.
    location = /readyz {
        include /etc/nginx/v2/proxy.conf;
        proxy_pass http://$commerce_upstream;
    }
    location / { return 404; }
}
server {
    listen 80;
    server_name canary-lab.flexperiment.ru;
    include /etc/nginx/conf.d/lab-realip.inc;
    root /usr/share/nginx/html;
    set $commerce_upstream ${V2_COMMERCE_UPSTREAM};
    include /etc/nginx/v2/common.conf;
    # V1 /v1/public/* and admin/partner paths deliberately do not pass.
    location = /v1/lab/catalogue {
        include /etc/nginx/v2/proxy.conf;
        proxy_pass http://$commerce_upstream;
    }
    location ~ ^/v1/lab/guest/(start|recover)$ {
        include /etc/nginx/v2/lab-guest-source-gate.conf;
        include /etc/nginx/v2/proxy.conf;
        proxy_pass http://$commerce_upstream;
    }
    location ~ ^/v1/lab/guest/(ticket|recover/confirm|reissue|refunds)$ {
        include /etc/nginx/v2/proxy.conf;
        proxy_pass http://$commerce_upstream;
    }
    location ~ ^/v1/(auth|me|lessons|checkout|email|legal)(/|$) {
        include /etc/nginx/v2/proxy.conf;
        proxy_pass http://$commerce_upstream;
    }
}
