FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/lab/package.json ./apps/lab/package.json
COPY packages/control-room-contracts/package.json ./packages/control-room-contracts/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
ARG SOURCE_COMMIT
ARG LAB_ORIGIN=https://lab.flexperiment.ru
ENV SOURCE_COMMIT=${SOURCE_COMMIT}
ENV LAB_ORIGIN=${LAB_ORIGIN}
COPY . .
RUN pnpm build

FROM nginx:1.29-alpine
COPY deploy/frontend.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/lab/out /usr/share/nginx/html
EXPOSE 80
