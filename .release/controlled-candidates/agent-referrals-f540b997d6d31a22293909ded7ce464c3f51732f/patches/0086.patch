diff --git old/deploy/Caddyfile new/deploy/Caddyfile
index fc36571..fb059b5 100644
--- old/deploy/Caddyfile
+++ new/deploy/Caddyfile
@@ -13,6 +13,16 @@ flexperiment.ru {
   file_server
 }
 
+# admin.flexperiment.ru and partner.flexperiment.ru both terminate at the
+# SAME frontend container (Dockerfile.admin's nginx image, service name
+# "admin" - never "commerce" directly, and never two separate services).
+# deploy/admin.nginx.conf's own server_name blocks are the actual host-based
+# routing boundary between the two realms (admin vs partner pages, and each
+# realm's own /v1/* proxy target inside that nginx) - see that file's
+# header. Routing either host straight to "commerce" here would bypass that
+# entire boundary, serving raw Commerce JSON instead of the frontend for
+# every non-API request. deploy/test-caddyfile-topology.sh asserts both
+# blocks below stay pointed at "admin", never "commerce".
 admin.flexperiment.ru {
   header {
     X-Content-Type-Options "nosniff"
@@ -20,5 +30,18 @@ admin.flexperiment.ru {
     X-Frame-Options "DENY"
     Strict-Transport-Security "max-age=31536000; includeSubDomains"
   }
-  reverse_proxy commerce:3001
+  reverse_proxy admin:80
+}
+
+# Mirrors the admin block above exactly - same frontend container, same
+# port. A future change to how this reference topology reaches that
+# container must update both blocks together.
+partner.flexperiment.ru {
+  header {
+    X-Content-Type-Options "nosniff"
+    Referrer-Policy "no-referrer"
+    X-Frame-Options "DENY"
+    Strict-Transport-Security "max-age=31536000; includeSubDomains"
+  }
+  reverse_proxy admin:80
 }
