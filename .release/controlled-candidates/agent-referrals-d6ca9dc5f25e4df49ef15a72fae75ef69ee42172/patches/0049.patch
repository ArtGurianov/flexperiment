+/** Transaction-owning wrapper for in-process callers; the HTTP surface uses the idempotent entry point below, exactly as retention and NPD do. */
+export const beginPayment = (db: Database.Database, admin: AdminPrincipal, settlementId: string): BeginPaymentResult =>
+  db.transaction(() => beginPaymentInTransaction(db, admin, settlementId)).immediate();
+
+/**
+ * PR-C2 DURABLE_KEY. payment_attempts_active_unique refuses a SECOND
+ * CONCURRENT attempt, which is not the same thing as refusing a retry:
+ * recording the first attempt as CONFIRMED_NOT_MADE frees that partial
+ * index, and beginning another payment after a failed one is exactly what
+ * an operator is supposed to do. The whole request body is one settlement
+ * id, so an identical body genuinely means both "retry my lost call" and
+ * "pay again" - only a caller-supplied command key can tell them apart, and
+ * this one moves money.
+ */
+export const beginPaymentIdempotent = (
+  db: Database.Database, admin: AdminPrincipal, idempotencyKey: string, settlementId: string,
+): AdminCommandResult<BeginPaymentResult> =>
+  db.transaction(() => withAdminCommandInTransaction<BeginPaymentResult>({
+    db, admin, command: "agent-referrals.payment.begin", idempotencyKey, request: { settlement_id: settlementId },
+    entityIdOf: (result) => result.attempt.id,
+    execute: () => beginPaymentInTransaction(db, admin, settlementId),
+  })).immediate();
