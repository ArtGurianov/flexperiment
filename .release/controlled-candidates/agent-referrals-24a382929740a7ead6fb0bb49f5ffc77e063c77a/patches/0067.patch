+import type Database from "better-sqlite3";
+import { recordPartnerIdentityEvent } from "./agent-referrals-onboarding";
+import { hashOpaqueToken } from "./agent-referrals-partner-auth";
+import type { PartnerPrincipal } from "./agent-referrals-partner-identity";
+
+/**
+ * Session lookup, always by hash - the raw token from the cookie never
+ * touches a comparison against a stored raw value, and revocation deletes
+ * server-side authority (revoked_at set) rather than depending on the
+ * browser to discard the cookie.
+ *
+ * `expires_at` is stored as the ISO 8601 string this codebase's Date
+ * objects produce (`...T...Z`), never SQLite's own `CURRENT_TIMESTAMP`
+ * shape (`... ...`, a space where ISO has `T`). Comparing the two directly
+ * as TEXT is a real bug: `'T'` sorts after `' '`, so an ISO expiry
+ * lexicographically compares GREATER than the current SQLite timestamp on
+ * the same UTC day regardless of the actual times involved - an
+ * already-expired session would still read as valid until the UTC date
+ * rolls over. `julianday()` parses both formats to the same numeric time
+ * axis and compares correctly.
+ *
+ * A destroyed identity can never resolve an existing session, even one
+ * that has not expired or been explicitly revoked - destruction ends
+ * partner authority immediately, not merely PII.
+ */
+export const resolvePartnerSession = (db: Database.Database, rawToken: string): PartnerPrincipal | undefined => {
+  const row = db.prepare(`SELECT s.id, s.partner_identity_id FROM partner_sessions s
+    JOIN partner_identities i ON i.id = s.partner_identity_id
+    WHERE s.token_hash = ? AND s.revoked_at IS NULL AND julianday(s.expires_at) > julianday('now') AND i.destroyed_at IS NULL`)
+    .get(hashOpaqueToken(rawToken)) as { id: string; partner_identity_id: string } | undefined;
+  return row ? { realm: "PARTNER", partner_identity_id: row.partner_identity_id, partner_session_id: row.id } : undefined;
+};
+
+export const revokePartnerSession = (db: Database.Database, partner: PartnerPrincipal): void => {
+  const run = db.transaction(() => {
+    db.prepare(`UPDATE partner_sessions SET revoked_at = CURRENT_TIMESTAMP WHERE id = ? AND revoked_at IS NULL`).run(partner.partner_session_id);
+    recordPartnerIdentityEvent(db, partner.partner_identity_id, "PARTNER_SESSION_REVOKED", "PARTNER", { partner_session_id: partner.partner_session_id });
+  });
+  run.immediate();
+};
